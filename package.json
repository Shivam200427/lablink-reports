{
  "name": "lablink",
  "version": "1.0.0",
  "description": "LabLink - lab report delivery portal for Company A Diagnostics (IsoCode take-home)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.js",
    "dev:client": "cd client && vite",
    "build": "cd client && vite build",
    "seed": "node server/seed.js",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
